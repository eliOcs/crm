<%# Support both local variable (from broadcast) and instance variable (from controller) %>
<% import = local_assigns[:active_import] || @active_pst_import %>
<% imports_history = local_assigns[:recent_imports] || @recent_pst_imports || [] %>

<div id="pst-import-status">
<% if import&.active? %>
  <div class="import-progress">
    <div class="import-progress__header">
      <span class="import-progress__status badge badge--<%= import.status %>">
        <%= import.status_label %>
      </span>
      <span class="import-progress__range"><%= import.display_filenames %></span>
    </div>

    <% if import.status == "extracting" %>
      <div class="import-progress__counting">
        <%= t("pst_import.extracting") %>
      </div>
      <div class="progress-bar progress-bar--indeterminate">
        <div class="progress-bar__fill"></div>
      </div>
    <% else %>
      <% if import.status == "enriching" %>
        <div class="import-progress__counting">
          <%= t("pst_import.enriching") %>
        </div>
      <% end %>
      <div class="progress-bar">
        <div class="progress-bar__fill" style="width: <%= import.progress_percentage %>%"></div>
      </div>
      <% if import.total_emails > 0 %>
        <div class="import-progress__stats">
          <span><%= t("pst_import.progress", processed: import.processed_emails, total: import.total_emails) %></span>
          <span>
            <%= import.progress_percentage %>%
            <% if import.time_remaining_text %>
              (<%= import.time_remaining_text %>)
            <% end %>
          </span>
        </div>
      <% end %>
    <% end %>

    <% if import.skipped_emails > 0 || import.failed_emails > 0 %>
      <div class="import-progress__details txt-subtle txt-sm">
        <% if import.skipped_emails > 0 %>
          <span><%= t("pst_import.skipped", count: import.skipped_emails) %></span>
        <% end %>
        <% if import.failed_emails > 0 %>
          <span><%= t("pst_import.failed", count: import.failed_emails) %></span>
        <% end %>
      </div>
    <% end %>

    <div class="import-progress__actions">
      <%= button_to t("common.cancel"),
            cancel_pst_import_settings_path(id: import.id),
            method: :delete,
            class: "btn btn--secondary btn--sm",
            data: { turbo_confirm: t("pst_import.cancel_confirm") } %>
      <p class="import-progress__hint txt-subtle txt-sm">
        <%= t("pst_import.background_hint") %>
      </p>
    </div>
  </div>
<% else %>
  <div class="pst-instructions">
    <h4 class="pst-instructions__title"><%= t("pst_import.instructions.title") %></h4>
    <ol class="forwarding-setup__steps">
      <% t("pst_import.instructions.steps").each do |step| %>
        <li><%= step.html_safe %></li>
      <% end %>
    </ol>
    <div class="pst-instructions__tips">
      <strong><%= t("pst_import.instructions.tips_title") %></strong>
      <ul class="forwarding-setup__steps">
        <% t("pst_import.instructions.tips").each do |tip| %>
          <li><%= tip.html_safe %></li>
        <% end %>
      </ul>
    </div>
  </div>

  <%= form_with url: start_pst_import_settings_path, method: :post, class: "pst-upload-form", multipart: true do |form| %>
    <div class="pst-upload-form__field">
      <%= form.label :inbox_pst_file, t("pst_import.inbox_file"), class: "pst-upload-form__label" %>
      <%= form.file_field :inbox_pst_file, accept: ".pst", class: "file-input" %>
      <p class="field__hint"><%= t("pst_import.inbox_hint") %></p>
    </div>

    <div class="pst-upload-form__field">
      <%= form.label :sent_pst_file, t("pst_import.sent_file"), class: "pst-upload-form__label" %>
      <%= form.file_field :sent_pst_file, accept: ".pst", class: "file-input" %>
      <p class="field__hint"><%= t("pst_import.sent_hint") %></p>
    </div>

    <div class="pst-upload-form__actions">
      <%= form.submit t("pst_import.start"), class: "btn btn--primary" %>
    </div>
    <p class="pst-upload-form__hint txt-sm txt-subtle">
      <%= t("pst_import.max_size", size: "5 GB") %>
    </p>
  <% end %>

  <% if imports_history.present? %>
    <div class="import-history mar-t-lg">
      <h3 class="txt-sm txt-subtle mar-b-sm"><%= t("pst_import.history") %></h3>
      <ul class="import-history__list">
        <% imports_history.each do |hist_import| %>
          <li class="import-history__item">
            <span class="badge badge--<%= hist_import.status %>"><%= hist_import.status_label %></span>
            <span class="import-history__range"><%= hist_import.display_filenames %></span>
            <span class="import-history__stats txt-subtle">
              <%= t("pst_import.history_stats",
                    imported: hist_import.imported_emails,
                    skipped: hist_import.skipped_emails) %>
            </span>
            <span class="import-history__date txt-subtle">
              <%= time_ago_in_words(hist_import.completed_at || hist_import.created_at) %> <%= t("common.ago") %>
            </span>
            <% if hist_import.failed? %>
              <%= button_to t("pst_import.retry"),
                    retry_pst_import_settings_path(id: hist_import.id),
                    method: :post,
                    class: "btn btn--secondary btn--xs" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>
</div>
