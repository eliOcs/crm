              <path d="M30.303 48.4848V9.09091L66.6667 36.3636L103.03 9.09091V48.4848L66.6667 75.7576" fill="#EA4335"/>
              <path d="M0 13.6364V25.7576L30.303 48.4848V9.09091L21.8182 2.72727C12.8182 -4.01515 0 2.39394 0 13.6364" fill="#C5221F"/>
            </svg>
            Gmail
          </button>
        </div>
      </div>

      <div class="forwarding-setup__content" data-tabs-target="panel" data-tab="outlook">
        <h4 class="forwarding-setup__section-title"><%= t("settings.inbound_email.received_emails") %></h4>
        <ol class="forwarding-setup__steps">
          <% t("settings.inbound_email.instructions_outlook.received_steps").each do |step| %>
            <li><%= step.html_safe %></li>
          <% end %>
        </ol>
      </div>

      <div class="forwarding-setup__content hidden" data-tabs-target="panel" data-tab="gmail">
        <h4 class="forwarding-setup__section-title"><%= t("settings.inbound_email.received_emails") %></h4>
        <ol class="forwarding-setup__steps">
          <% t("settings.inbound_email.instructions_gmail.received_steps").each do |step| %>
            <li><%= step.html_safe %></li>
          <% end %>
        </ol>
      </div>
    </div>

    <div class="forwarding-setup__section">
      <h4 class="forwarding-setup__section-title"><%= t("settings.inbound_email.sent_emails") %></h4>
      <ol class="forwarding-setup__steps">
        <% t("settings.inbound_email.sent_steps").each do |step| %>
          <li><%= step.html_safe %></li>
        <% end %>
      </ol>
    </div>
  <% else %>
    <p class="forwarding-disabled-hint"><%= t("settings.inbound_email.disabled_hint") %></p>
  <% end %>
</div>

<div class="info-card">
  <h2><%= t("settings.integrations") %></h2>

  <div class="field">
    <label><%= t("settings.microsoft.title") %></label>
    <p class="field__hint"><%= t("settings.microsoft.description") %></p>

    <% if Current.user.microsoft_connected? %>
      <div class="integration-status">
        <span class="integration-status__email">
          <%= t("settings.microsoft.connected_as", email: Current.user.microsoft_credential.email) %>
        </span>
        <%= button_to t("settings.microsoft.disconnect"),
              disconnect_auth_microsoft_path,
              method: :delete,
              class: "btn btn--secondary",
              data: { turbo_confirm: t("settings.microsoft.disconnect_confirm") } %>
      </div>
    <% else %>
      <%= link_to t("settings.microsoft.connect"),
            connect_auth_microsoft_path,
            class: "btn btn--primary",
            data: { turbo: false } %>
    <% end %>
  </div>
</div>

<% if Current.user.microsoft_connected? %>
  <div class="info-card">
    <h2><%= t("microsoft_import.title") %></h2>
    <p class="field__hint mar-b-md"><%= t("microsoft_import.description") %></p>

    <%= turbo_stream_from Current.user, :microsoft_import %>
    <%= render "microsoft_import_status" %>
  </div>
<% end %>

<div class="info-card">
  <h2><%= t("pst_import.title") %></h2>
  <p class="field__hint mar-b-md"><%= t("pst_import.description") %></p>

  <%= turbo_stream_from Current.user, :pst_import %>
  <%= render "pst_import_status" %>
</div>
