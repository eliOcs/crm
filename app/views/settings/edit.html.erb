<div class="page-header">
  <h1 class="page-header__title"><%= t("settings.title") %></h1>
</div>

<div class="info-card">
  <%= form_with model: Current.user, url: settings_path, method: :patch, class: "form" do |form| %>
    <div class="field">
      <%= form.label :locale, t("settings.language") %>
      <p class="field__hint"><%= t("settings.language_description") %></p>
      <%= form.select :locale,
            options_for_select([
              [t("settings.languages.en"), "en"],
              [t("settings.languages.es"), "es"]
            ], Current.user.locale),
            {},
            class: "select" %>
    </div>

    <div class="form__actions">
      <%= form.submit t("common.save"), class: "btn btn--primary" %>
    </div>
  <% end %>
</div>

<div class="info-card">
  <div class="forwarding-header">
    <div class="forwarding-header__text">
      <h2><%= t("settings.inbound_email.title") %></h2>
      <p class="field__hint"><%= t("settings.inbound_email.description") %></p>
    </div>
    <%= form_with model: Current.user, url: settings_path, method: :patch, data: { controller: "auto-submit" } do |form| %>
      <label class="toggle">
        <%= form.check_box :inbound_email_enabled, class: "toggle__input", data: { action: "change->auto-submit#submit" } %>
        <span class="sr-only"><%= t("settings.inbound_email.enabled") %></span>
      </label>
    <% end %>
  </div>

  <% if Current.user.inbound_email_enabled? %>
    <div class="forwarding-address">
      <label class="forwarding-address__label"><%= t("settings.inbound_email.your_address") %></label>
      <div class="forwarding-address__field" data-controller="clipboard">
        <code class="forwarding-address__value" data-clipboard-target="source"><%= Current.user.inbound_email_address %></code>
        <button type="button" class="forwarding-address__copy" data-action="clipboard#copy" data-clipboard-target="button" title="<%= t("settings.inbound_email.copy") %>">
          <svg data-clipboard-target="icon" class="forwarding-address__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg data-clipboard-target="checkIcon" class="forwarding-address__icon forwarding-address__icon--check hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span data-clipboard-target="label" class="forwarding-address__copy-label"><%= t("settings.inbound_email.copy") %></span>
        </button>
      </div>
      <div class="forwarding-address__actions">
        <%= button_to regenerate_inbound_email_settings_path,
              method: :post,
              class: "forwarding-address__regenerate",
              data: { turbo_confirm: t("settings.inbound_email.regenerate_confirm") } do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="forwarding-address__regenerate-icon">
            <path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16"/>
          </svg>
          <%= t("settings.inbound_email.regenerate") %>
        <% end %>
      </div>
    </div>

    <div class="forwarding-setup" data-controller="tabs">
      <div class="forwarding-setup__header">
        <span class="forwarding-setup__title"><%= t("settings.inbound_email.instructions") %></span>
        <div class="forwarding-setup__tabs">
          <button type="button" class="forwarding-setup__tab forwarding-setup__tab--active" data-tabs-target="tab" data-action="tabs#switch" data-tab="outlook">
            <svg class="forwarding-setup__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Outlook
          </button>
          <button type="button" class="forwarding-setup__tab" data-tabs-target="tab" data-action="tabs#switch" data-tab="gmail">
            <svg class="forwarding-setup__tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Gmail
          </button>
        </div>
      </div>

      <div class="forwarding-setup__content" data-tabs-target="panel" data-tab="outlook">
        <ol class="forwarding-setup__steps">
          <% t("settings.inbound_email.instructions_outlook.steps").each do |step| %>
            <li><%= step.html_safe %></li>
          <% end %>
        </ol>
      </div>

      <div class="forwarding-setup__content hidden" data-tabs-target="panel" data-tab="gmail">
        <ol class="forwarding-setup__steps">
          <% t("settings.inbound_email.instructions_gmail.steps").each do |step| %>
            <li><%= step.html_safe %></li>
          <% end %>
        </ol>
      </div>
    </div>
  <% else %>
    <p class="forwarding-disabled-hint"><%= t("settings.inbound_email.disabled_hint") %></p>
  <% end %>
</div>

<div class="info-card">
  <h2><%= t("settings.integrations") %></h2>

  <div class="field">
    <label><%= t("settings.microsoft.title") %></label>
    <p class="field__hint"><%= t("settings.microsoft.description") %></p>

    <% if Current.user.microsoft_connected? %>
      <div class="integration-status">
        <span class="integration-status__email">
          <%= t("settings.microsoft.connected_as", email: Current.user.microsoft_credential.email) %>
        </span>
        <%= button_to t("settings.microsoft.disconnect"),
              disconnect_auth_microsoft_path,
              method: :delete,
              class: "btn btn--secondary",
              data: { turbo_confirm: t("settings.microsoft.disconnect_confirm") } %>
      </div>
    <% else %>
      <%= link_to t("settings.microsoft.connect"),
            connect_auth_microsoft_path,
            class: "btn btn--primary",
            data: { turbo: false } %>
    <% end %>
  </div>
</div>

<% if Current.user.microsoft_connected? %>
  <div class="info-card">
    <h2><%= t("microsoft_import.title") %></h2>
    <p class="field__hint mar-b-md"><%= t("microsoft_import.description") %></p>

    <%= turbo_stream_from Current.user, :microsoft_import %>
    <%= render "microsoft_import_status" %>
  </div>
<% end %>
