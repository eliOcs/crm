                <linearGradient id="outlook-gradient" x1="162.75" y1="322.26" x2="774.09" y2="1381.07" gradientUnits="userSpaceOnUse">
                  <stop offset="0" stop-color="#1784D9"/>
                  <stop offset="0.5" stop-color="#107AD5"/>
                  <stop offset="1" stop-color="#0A63C9"/>
                </linearGradient>
              </defs>
            </svg>
            Outlook
          </button>
          <button type="button" class="forwarding-setup__tab" data-tabs-target="tab" data-action="tabs#switch" data-tab="gmail">
            <svg class="forwarding-setup__tab-icon" viewBox="0 0 134 100">
              <path d="M9.09091 100H30.303V48.4848L0 25.7576V90.9091C0 95.9394 4.07576 100 9.09091 100Z" fill="#4285F4"/>
