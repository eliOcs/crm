              <path fill="url(#outlook-gradient)" d="M78.055,383.25h780.723c43.109,0,78.055,34.947,78.055,78.055v780.723c0,43.109-34.946,78.055-78.055,78.055H78.055c-43.109,0-78.055-34.947-78.055-78.055V461.305C0,418.197,34.947,383.25,78.055,383.25z"/>
